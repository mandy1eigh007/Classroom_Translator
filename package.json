{
  "name": "classroom-translator",
  "version": "2.0.0",
  "description": "ClassLingo — trade-aware workforce translation on Cloudflare Pages + Workers KV",
  "private": true,
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./public/tailwind.css --minify",
    "dev": "wrangler pages dev",
    "dev:miner": "wrangler dev --config wrangler.video-miner.jsonc --test-scheduled",
    "check:miner": "wrangler deploy --config wrangler.video-miner.jsonc --dry-run",
    "deploy": "wrangler pages deploy",
    "test:smoke": "node tests/release-smoke.mjs",
    "test:mining": "node tests/video-mining.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.110.0"
  }
}
